# ── Stage 1: build the Vite SPA from source ──────────────────────────────────
FROM node:22-alpine AS builder

RUN npm install -g pnpm@10.26.1

WORKDIR /app

# Copy workspace manifests for layer-cache efficiency
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# Copy shared libs + marketplace source
COPY lib/ ./lib/
COPY artifacts/marketplace/ ./artifacts/marketplace/

# Install only marketplace dependencies (and its workspace deps)
RUN pnpm install --filter "@workspace/marketplace..." --frozen-lockfile

# Build with BASE_PATH="/" so all /api/... calls hit the same origin
RUN BASE_PATH="/" pnpm --filter @workspace/marketplace run build

# ── Stage 2: serve with nginx ─────────────────────────────────────────────────
FROM nginx:1.27-alpine

RUN rm /etc/nginx/conf.d/default.conf

# SPA config: client-side routes → index.html, hashed assets cached 1 year
RUN printf 'server {\n\
    listen 8080;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    gzip on;\n\
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
        access_log off;\n\
    }\n\
}\n' > /etc/nginx/conf.d/app.conf

# Copy freshly built SPA
COPY --from=builder /app/artifacts/marketplace/dist/public /usr/share/nginx/html

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
