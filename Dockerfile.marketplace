# ── Stage 1: build the Marketplace SPA from the checked-out source ───────────
# The production image must not depend on a generated dist/ directory being
# committed alongside source changes. Otherwise a successful source deploy can
# still serve an old JavaScript bundle.
FROM node:22-alpine AS builder

RUN npm install -g pnpm@10.26.1

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json tsconfig.json ./
COPY lib/ ./lib/
COPY artifacts/marketplace/ ./artifacts/marketplace/

# Install Marketplace plus its workspace dependencies only.
RUN pnpm install --filter "@workspace/marketplace..." --frozen-lockfile

# Marketplace is served at the custom-domain root by nginx.
RUN BASE_PATH=/ pnpm --filter @workspace/marketplace run build

# ── Stage 2: serve the Vite SPA with nginx ───────────────────────────────────
FROM nginx:1.27-alpine

RUN rm /etc/nginx/conf.d/default.conf

# SPA + crawler SEO: bots requesting /listings/:id or /categories/:slug are
# reverse-proxied to the API SEO HTML handlers. Humans still get the SPA.
COPY artifacts/marketplace/nginx.seo.conf /etc/nginx/conf.d/app.conf

# Copy the bundle that was freshly built from this deployment's source.
COPY --from=builder /app/artifacts/marketplace/dist/public /usr/share/nginx/html

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
