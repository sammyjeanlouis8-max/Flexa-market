default_platform(:ios)

platform :ios do
  lane :build_and_upload do
    # 1. Temporary keychain so certificates can be installed on the CI runner
    keychain_name     = "ci_keychain"
    keychain_password = "Flexa_CI_2026!"
    create_keychain(
      name:              keychain_name,
      password:          keychain_password,
      default_keychain:  true,
      unlock:            true,
      timeout:           3600,
      add_to_search_list: true,
      lock_when_sleeps:  false
    )

    # 2. Load ASC API key (used for cert/profile management + TestFlight upload)
    api_key = app_store_connect_api_key(
      key_id:      ENV["ASC_KEY_ID"],
      issuer_id:   ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      duration:    1200,
      in_house:    false
    )

    # 3. Fetch (or create) an iOS Distribution certificate and install it
    get_certificates(
      api_key:           api_key,
      output_path:       "/tmp/certs",
      keychain_name:     keychain_name,
      keychain_password: keychain_password,
      platform:          "ios",
      type:              "distribution"      # App Store / Ad Hoc
    )

    # 4. Fetch (or create) the App Store provisioning profile
    get_provisioning_profile(
      api_key:         api_key,
      app_identifier:  "com.flexamarket.mobile",
      output_path:     "/tmp/profiles",
      provisioning_name: "FlexaMarket AppStore",
      ignore_profiles_with_different_name: false,
      app_store:       true,                 # Distribution, not Development
      force:           false
    )

    # 5. Build & archive
    build_ios_app(
      project:            "FlexaMarket.xcodeproj",
      scheme:             "FlexaMarket",
      configuration:      "Release",
      export_method:      "app-store",
      output_directory:   "/tmp/ipa_output",
      output_name:        "FlexaMarket.ipa",
      clean:              true,
      codesigning_identity: "Apple Distribution",
      xcargs:             "DEVELOPMENT_TEAM=D782MM56VY"
    )

    # 6. Upload to TestFlight (skip waiting so the job doesn't time out)
    upload_to_testflight(
      api_key:                            api_key,
      ipa:                                "/tmp/ipa_output/FlexaMarket.ipa",
      skip_waiting_for_build_processing:  true
    )

    # 7. Clean up keychain
    delete_keychain(name: keychain_name)
  end
end
