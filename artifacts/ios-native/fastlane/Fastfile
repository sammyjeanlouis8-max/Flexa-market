default_platform(:ios)

platform :ios do
  lane :build_and_upload do
    stage = "create_keychain"
    begin
    require "securerandom"
    keychain_name     = "ci_keychain"
    keychain_password = SecureRandom.hex(24)
    keychain_path     = nil

    # 1. Temporary keychain for the CI runner
    create_keychain(
      name:               keychain_name,
      password:           keychain_password,
      default_keychain:   true,
      unlock:             true,
      timeout:            3600,
      add_to_search_list: true,
      lock_when_sleeps:   false
    )
    # Fastlane returns "~/Library/Keychains/ci_keychain" in lane_context,
    # while macOS stores the actual keychain as "ci_keychain-db".
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    UI.user_error!("The temporary signing keychain was not created") unless File.file?(keychain_path)

    # 2. ASC API key (cert + profile management + TestFlight upload)
    stage = "validate_apple_key"
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    key_content = ENV["ASC_KEY_P8"].to_s.gsub("\\n", "\n").strip
    if key_id.empty? || issuer_id.empty? || key_content.empty?
      UI.user_error!("ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_P8 must all be set")
    end
    require "openssl"
    begin
      OpenSSL::PKey.read(key_content)
    rescue OpenSSL::PKey::PKeyError
      UI.user_error!("ASC_KEY_P8 is not a valid Apple private key")
    end

    stage = "authenticate_with_apple"
    api_key = app_store_connect_api_key(
      key_id:      key_id,
      issuer_id:   issuer_id,
      key_content: key_content,
      duration:    1200,
      in_house:    false
    )

    # Distinguish an invalid/mismatched API key from a key that lacks
    # Certificates, Identifiers & Profiles permission.
    stage = "verify_apple_app_access"
    app = Spaceship::ConnectAPI::App.find("com.flexamarket.mobile")
    unless app
      UI.user_error!("The Apple API key cannot see the legacy Flexa Market app")
    end
    puts "::notice title=Apple app access::Signing key can see the legacy app"

    # 3. Reuse an existing Apple Distribution identity. Never create or revoke
    #    certificates in this release lane.
    stage = "validate_existing_distribution_certificate"
    require "base64"
    require "tmpdir"
    require "net/http"
    require "json"
    require "open3"
    encoded_p12 = ENV["IOS_SIGNING_P12_BASE64"].to_s.gsub(/\s/, "")
    p12_password = ENV["IOS_SIGNING_P12_PASSWORD"].to_s
    if encoded_p12.empty? || p12_password.empty?
      UI.user_error!("IOS_SIGNING_P12_BASE64 and IOS_SIGNING_P12_PASSWORD must be set in GitHub Actions secrets")
    end
    begin
      p12_bytes = Base64.strict_decode64(encoded_p12)
      identity = OpenSSL::PKCS12.new(p12_bytes, p12_password)
    rescue ArgumentError, OpenSSL::PKCS12::PKCS12Error
      UI.user_error!("The existing signing certificate or its password is invalid")
    end
    certificate = identity.certificate
    unless certificate && identity.key && certificate.not_after > Time.now &&
           certificate.not_before <= Time.now && certificate.check_private_key(identity.key) &&
           certificate.subject.to_a.any? { |name, value, _type| name == "OU" && value == "D782MM56VY" }
      UI.user_error!("The existing signing identity has no private key, or its certificate has expired")
    end
    require_relative "../../../tools/ios-signing-identity"
    begin
      signing_identity_label = IosSigningIdentity.label(certificate)
    rescue ArgumentError
      UI.user_error!("The existing signing certificate is not a supported distribution signing identity")
    end

    uri = URI("https://api.appstoreconnect.apple.com/v1/certificates?limit=200")
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) do |http|
      http.get(uri.request_uri, "Authorization" => "Bearer #{Spaceship::ConnectAPI.token.text}")
    end
    unless response.is_a?(Net::HTTPSuccess)
      UI.user_error!("Could not verify the existing signing certificate with Apple")
    end
    registered_certificate = JSON.parse(response.body).fetch("data", []).find do |record|
      next false unless %w[DISTRIBUTION IOS_DISTRIBUTION].include?(record.dig("attributes", "certificateType"))
      Base64.decode64(record.dig("attributes", "certificateContent").to_s) == certificate.to_der
    end
    unless registered_certificate
      UI.user_error!("The supplied .p12 is not an active Apple Distribution certificate for this team; no certificate was created or revoked")
    end

    # macOS Security does not accept every PKCS#12 encoding that OpenSSL
    # validates. Keep the owner's encrypted backup unchanged; re-encode only
    # this verified identity into a protected, short-lived import container.
    require_relative "../../../tools/ios-native-p12"
    stage = "prepare_native_distribution_certificate"
    begin
      IosNativeP12.with_import_bundle(identity) do |native_path, native_password|
        stage = "import_existing_distribution_certificate"
        _, _, import_status = Open3.capture3(
          "/usr/bin/security", "import", native_path,
          "-k", keychain_path, "-P", native_password,
          "-T", "/usr/bin/codesign", "-T", "/usr/bin/security"
        )
        UI.user_error!("Native signing identity import failed") unless import_status.success?
      end
    rescue IosNativeP12::Failure => error
      UI.user_error!("Temporary signing container preparation failed: #{error.category}")
    end
    stage = "authorize_existing_distribution_key"
    _, _, partition_status = Open3.capture3(
      "security", "set-key-partition-list", "-S", "apple-tool:,apple:,codesign:",
      "-s", "-k", keychain_password, keychain_path
    )
    UI.user_error!("Could not authorize the signing key for codesign") unless partition_status.success?
    identities, _, identities_status = Open3.capture3(
      "security", "find-identity", "-v", "-p", "codesigning", keychain_path
    )
    fingerprint = OpenSSL::Digest::SHA1.hexdigest(certificate.to_der).upcase
    unless identities_status.success? && identities.match?(/\b#{Regexp.escape(fingerprint)}\b/)
      UI.user_error!("The supplied certificate and private key were not imported as a valid signing identity")
    end

    # 4. Download/create only the legacy app's profile for this exact certificate.
    stage = "get_app_store_profile"
    get_provisioning_profile(
      api_key:        api_key,
      app_identifier: "com.flexamarket.mobile",
      cert_id:        registered_certificate.fetch("id"),
      platform:       "ios",
      # Omitted exclusive flags use Sigh's App Store defaults. Explicitly
      # supplying both false still triggers Fastlane's conflict validation.
      output_path:    "/tmp/profiles"
    )

    # 5. Switch project from Automatic → Manual signing
    stage = "configure_code_signing"
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    profile_name = lane_context[SharedValues::SIGH_NAME].to_s
    unless profile_path && File.file?(profile_path) && !profile_name.empty?
      UI.user_error!("Apple did not return a usable App Store provisioning profile")
    end
    UI.message "Using provisioning profile: #{profile_name}"

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "FlexaMarket.xcodeproj",
      team_id:               "D782MM56VY",
      bundle_identifier:     "com.flexamarket.mobile",
      profile_name:          profile_name,
      code_sign_identity:    signing_identity_label
    )

    # 6. Build & archive
    #    xcargs explicitly force asset-catalog icon name in case
    #    update_code_signing_settings disturbs build settings
    stage = "build_ios_app"
    build_ios_app(
      project:          "FlexaMarket.xcodeproj",
      scheme:           "FlexaMarket",
      configuration:    "Release",
      export_method:    "app-store",
      export_options:   {
        signingStyle: "manual",
        teamID: "D782MM56VY",
        provisioningProfiles: { "com.flexamarket.mobile" => profile_name }
      },
      output_directory: "/tmp/ipa_output",
      output_name:      "FlexaMarket.ipa",
      clean:            true,
      xcargs:           "ASSETCATALOG_COMPILER_APPICON_NAME=AppIcon GENERATE_INFOPLIST_FILE=NO"
    )

    # 7. Verify the built app's identity before uploading anything to Apple.
    stage = "verify_ipa_identity"
    ipa_path = "/tmp/ipa_output/FlexaMarket.ipa"
    entries, _, list_status = Open3.capture3("unzip", "-Z1", ipa_path)
    info_entries = entries.lines.map(&:strip).grep(/\APayload\/[^\/]+\.app\/Info\.plist\z/)
    UI.user_error!("The built IPA has no unique app Info.plist") unless list_status.success? && info_entries.length == 1
    info_bytes, _, unzip_status = Open3.capture3("unzip", "-p", ipa_path, info_entries.first)
    UI.user_error!("Could not inspect the built IPA") unless unzip_status.success?
    ipa_info_path = File.join(Dir.tmpdir, "flexa-info-#{SecureRandom.hex(12)}.plist")
    File.open(ipa_info_path, File::WRONLY | File::CREAT | File::EXCL, 0600) { |file| file.write(info_bytes) }
    {
      "CFBundleIdentifier" => "com.flexamarket.mobile",
      "CFBundleShortVersionString" => "1.0.1",
      "CFBundleVersion" => "97",
      "RevenueCatApiKey" => "appl_uwCdAGjnZnpJgnwhOKCFHRYMewP"
    }.each do |key, expected|
      actual, _, inspect_status = Open3.capture3("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", ipa_info_path)
      UI.user_error!("Built IPA has the wrong #{key}") unless inspect_status.success? && actual.strip == expected
    end

    # 8. Upload to TestFlight
    stage = "upload_to_testflight"
    upload_to_testflight(
      api_key:                           api_key,
      app_identifier:                    "com.flexamarket.mobile",
      ipa:                               ipa_path,
      skip_waiting_for_build_processing: false
    )

    rescue => e
      # Job annotations are visible without downloading private Actions logs.
      # Never send signing errors (which may contain sensitive data) to a public endpoint.
      puts "::error title=iOS release failed::Stage: #{stage}; error class: #{e.class}"
      raise e
    ensure
      begin
        File.delete(ipa_info_path) if defined?(ipa_info_path) && ipa_info_path && File.file?(ipa_info_path)
      ensure
        delete_keychain(name: keychain_name) if defined?(keychain_path) && keychain_path && File.exist?(keychain_path)
      end
    end
  end
end
