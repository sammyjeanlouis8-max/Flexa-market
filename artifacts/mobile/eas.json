{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_DOMAIN": "flexamarket.com"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "ios": {
        "credentialsSource": "remote"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DOMAIN": "flexamarket.com",
        "EXPO_ROUTER_APP_ROOT": "app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "samueljeanlouis37@icloud.com",
        "ascAppId": "6754947270",
        "ascApiKeyPath": "/tmp/AuthKey_2PT7VT62LY.p8",
        "ascApiKeyId": "2PT7VT62LY",
        "ascApiKeyIssuerId": "747bde63-c170-4c5d-aaf2-098c45831671"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    }
  }
}
