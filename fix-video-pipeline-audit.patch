+      const meta = () => { statusEl.textContent = `✅ HTTP 200 · loadedmetadata · ${video.videoWidth}x${video.videoHeight} · ${video.duration.toFixed(2)}s`; statusEl.className='status ok'; };
+      video.addEventListener('error', fail);
+      video.addEventListener('loadedmetadata', meta);
+    }
+    attach(document.getElementById('v1'), document.getElementById('s1'), broken);
+    attach(document.getElementById('v2'), document.getElementById('s2'), fixed);
+
+    // Also do a fetch HEAD against both URLs and surface the HTTP status independently
+    // of what the <video> element does — this proves the network-level outcome.
+    async function probe(url, statusEl) {
+      try {
+        const r = await fetch(url, { method: 'GET', headers: { Range: 'bytes=0-1023' } });
+        const txt = `HTTP ${r.status} · content-type=${r.headers.get('content-type')} · content-length=${r.headers.get('content-length') ?? r.headers.get('content-range')}`;
+        statusEl.textContent += ' · ' + txt;
+      } catch (e) {
+        statusEl.textContent += ' · fetch FAIL: ' + e.message;
+      }
+    }
+    probe(broken, document.getElementById('s1'));
+    probe(fixed,  document.getElementById('s2'));
+  </script>
+</body>
+</html>
