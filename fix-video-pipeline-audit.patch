diff --git a/scripts/repair-video-urls.sql b/scripts/repair-video-urls.sql
new file mode 100644
index 0000000..a5f3fd0
--- /dev/null
+++ b/scripts/repair-video-urls.sql
@@ -0,0 +1,114 @@
+-- ============================================================================
+-- One-time recovery migration: repair video URLs broken by the buggy
+-- `fl_faststart` admin migration that ran on FlexaMarket production.
+-- ============================================================================
+--
+-- Cloudinary REJECTS every delivery URL that contains the `fl_faststart`
+-- flag with HTTP 400 ("Invalid flag in transformation: faststart").
+-- That HTTP 400 is what causes the persistent "black video" symptom in
+-- the FlexaMarket frontend (MediaError code 4).
+--
+-- This migration:
+--   1. Strips ALL `fl_faststart,…` segments (including the doubled form
+--      `fl_faststart,vc_h264,f_mp4/fl_faststart,vc_h264,f_mp4/` that the
+--      old admin route baked into rows).
+--   2. Collapses any duplicated `vc_h264,f_mp4/` segments.
+--   3. Re-applies `vc_h264,f_mp4` exactly once (a valid Cloudinary
+--      transformation that delivers MP4/H.264, playable on every modern
+--      browser including iOS Safari).
+--
+-- Idempotent: rows that no longer contain `fl_faststart` AND already
+-- have a single `vc_h264,f_mp4/` segment are left alone.
+--
+-- Run BEFORE deploying the new application code, or run via the new
+-- `POST /api/admin/migrate-video-urls` endpoint AFTER deploying.
+-- ============================================================================
+
+BEGIN;
+
+-- Preview what we are about to touch (count the broken rows).
+SELECT COUNT(*) AS broken_boost_video_rows
+FROM listings
+WHERE boost_video_url LIKE '%fl_faststart%';
+
+SELECT COUNT(*) AS broken_listing_video_rows
+FROM listings
+WHERE listing_video_url LIKE '%fl_faststart%';
+
+-- Pass 1: strip every `fl_faststart,…/` segment from boost_video_url.
+-- The regex matches the segment shape Cloudinary delivers; greedy `+`
+-- handles the doubled form.
+UPDATE listings
+SET boost_video_url = regexp_replace(
+    boost_video_url,
+    '/video/upload/(fl_faststart[^/]*/)+',
+    '/video/upload/',
+    'g'
+)
+WHERE boost_video_url LIKE '%fl_faststart%';
+
+-- Pass 2: collapse duplicate `vc_h264,f_mp4/` segments.
+UPDATE listings
+SET boost_video_url = regexp_replace(
+    boost_video_url,
+    '/video/upload/(vc_h264,f_mp4/)+',
+    '/video/upload/',
+    'g'
+)
+WHERE boost_video_url LIKE '%vc_h264,f_mp4/vc_h264,f_mp4/%';
+
+-- Pass 3: re-apply `vc_h264,f_mp4/` exactly once, on every Cloudinary
+-- video URL that does not yet have it. Skip rows that already have it
+-- to keep the migration idempotent.
+UPDATE listings
+SET boost_video_url = regexp_replace(
+    boost_video_url,
+    '/video/upload/(?!vc_h264,f_mp4/)',
+    '/video/upload/vc_h264,f_mp4/'
+)
+WHERE boost_video_url LIKE '%res.cloudinary.com%/video/upload/%'
+  AND boost_video_url NOT LIKE '%/video/upload/vc_h264,f_mp4/%';
+
+-- Same three passes for `listing_video_url` (used by non-boost video posts).
+UPDATE listings
+SET listing_video_url = regexp_replace(
+    listing_video_url,
+    '/video/upload/(fl_faststart[^/]*/)+',
+    '/video/upload/',
+    'g'
+)
+WHERE listing_video_url LIKE '%fl_faststart%';
+
+UPDATE listings
+SET listing_video_url = regexp_replace(
+    listing_video_url,
+    '/video/upload/(vc_h264,f_mp4/)+',
+    '/video/upload/',
+    'g'
+)
+WHERE listing_video_url LIKE '%vc_h264,f_mp4/vc_h264,f_mp4/%';
+
+UPDATE listings
+SET listing_video_url = regexp_replace(
+    listing_video_url,
+    '/video/upload/(?!vc_h264,f_mp4/)',
+    '/video/upload/vc_h264,f_mp4/'
+)
+WHERE listing_video_url LIKE '%res.cloudinary.com%/video/upload/%'
+  AND listing_video_url NOT LIKE '%/video/upload/vc_h264,f_mp4/%';
+
+-- Verification: should report 0.
+SELECT COUNT(*) AS still_broken_after_migration
+FROM listings
+WHERE boost_video_url LIKE '%fl_faststart%'
+   OR listing_video_url LIKE '%fl_faststart%';
+
+-- Sample 5 repaired rows.
+SELECT id, boost_video_url
+FROM listings
+WHERE boost_video_url IS NOT NULL
+  AND boost_video_url LIKE '%res.cloudinary.com%'
+ORDER BY id DESC
+LIMIT 5;
+
+COMMIT;
