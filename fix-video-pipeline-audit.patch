+/**
+ * Normalize a Cloudinary video URL to a guaranteed-playable form.
+ *
+ * BUG HISTORY (do not reintroduce):
+ *   `fl_faststart` is NOT a valid Cloudinary URL transformation flag.
+ *   Cloudinary's delivery endpoint rejects any URL containing it with
+ *   HTTP 400 ("Invalid flag in transformation: faststart"), producing
+ *   the persistent "black video" symptom in the app. The flag is only
+ *   accepted inside an `eager: [{ flags: "faststart" }]` parameter at
+ *   UPLOAD time. (Verified live against res.cloudinary.com on 2026-06-09.)
+ *
+ * Behavior:
+ *   • Non-Cloudinary / non-video URLs are returned untouched.
+ *   • Strips any stale `fl_faststart,...` segment(s) — handles the
+ *     duplicated form `fl_faststart,vc_h264,f_mp4/fl_faststart,...` that
+ *     a previous admin migration baked into the database.
+ *   • Applies `vc_h264,f_mp4` exactly once. These ARE valid Cloudinary
+ *     transformations and produce an MP4 stream playable in every
+ *     modern browser (iOS Safari, Android Chrome, Desktop Chrome/Firefox).
+ *   • Idempotent: calling it multiple times yields the same result.
+ */
+const STALE_FASTSTART_SEGMENT_RE = /\/video\/upload\/(?:fl_faststart[^/]*\/)+/g;
+const VC_H264_SEGMENT_RE         = /\/video\/upload\/(?:vc_h264,f_mp4\/)+/g;
+
 export function toStreamingUrl(url: string): string {
-  if (
-    url &&
-    url.includes("res.cloudinary.com") &&
-    url.includes("/video/upload/") &&
-    !url.includes("fl_faststart")
-  ) {
-    return url.replace("/video/upload/", "/video/upload/fl_faststart,vc_h264,f_mp4/");
+  if (!url || !url.includes("res.cloudinary.com") || !url.includes("/video/upload/")) {
+    return url;
   }
-  return url;
+  // 1) Strip any pre-existing fl_faststart,... segments (including duplicates).
+  let cleaned = url.replace(STALE_FASTSTART_SEGMENT_RE, "/video/upload/");
+  // 2) Strip any pre-existing vc_h264,f_mp4/ segments so we can re-apply once.
+  cleaned = cleaned.replace(VC_H264_SEGMENT_RE, "/video/upload/");
+  // 3) Apply the valid transform exactly once.
+  return cleaned.replace("/video/upload/", "/video/upload/vc_h264,f_mp4/");
 }
 
