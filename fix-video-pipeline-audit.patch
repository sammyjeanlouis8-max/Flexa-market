+/**
+ * Unit tests for the video URL transformation helpers.
+ *
+ * These prove that:
+ *   1. The valid runtime URL form is `vc_h264,f_mp4/` — NO `fl_faststart`.
+ *   2. Stale `fl_faststart,...` segments are stripped (including the
+ *      duplicated form previously baked into the database).
+ *   3. The transformation is idempotent (safe to call multiple times).
+ *   4. Non-Cloudinary URLs and local /objects/ paths are untouched.
+ *
+ * Run with: node --import tsx artifacts/api-server/src/lib/__tests__/cloudinary.test.ts
+ */
+import { strict as assert } from "node:assert";
+import { toStreamingUrl, toPosterUrl } from "../cloudinary";
+
+let passed = 0;
+let failed = 0;
+function test(name: string, fn: () => void) {
+  try { fn(); console.log(`  ✅ ${name}`); passed++; }
+  catch (e) { console.log(`  ❌ ${name}\n     ${(e as Error).message}`); failed++; }
+}
+
+console.log("\n── toStreamingUrl ──────────────────────────────────────────────");
+
+const CLOUD = "https://res.cloudinary.com/dvkbgodbk/video/upload";
+const TAIL  = "v1781025476/flexa-market/vnubcg5cytce3psi0i0s.mov";
+
+test("raw Cloudinary URL → adds vc_h264,f_mp4", () => {
+  const input  = `${CLOUD}/${TAIL}`;
+  const output = toStreamingUrl(input);
+  assert.equal(output, `${CLOUD}/vc_h264,f_mp4/${TAIL}`);
+  assert.ok(!output.includes("fl_faststart"), "must not contain fl_faststart");
+});
+
+test("URL with single fl_faststart segment → strips it, applies vc_h264,f_mp4", () => {
+  const input  = `${CLOUD}/fl_faststart,vc_h264,f_mp4/${TAIL}`;
+  const output = toStreamingUrl(input);
+  assert.equal(output, `${CLOUD}/vc_h264,f_mp4/${TAIL}`);
+  assert.ok(!output.includes("fl_faststart"));
+});
+
+test("URL with DUPLICATED fl_faststart (the DB bug) → strips both, applies once", () => {
+  const input  = `${CLOUD}/fl_faststart,vc_h264,f_mp4/fl_faststart,vc_h264,f_mp4/${TAIL}`;
+  const output = toStreamingUrl(input);
+  assert.equal(output, `${CLOUD}/vc_h264,f_mp4/${TAIL}`);
+  // Must not contain any fl_faststart
+  assert.ok(!output.includes("fl_faststart"));
+  // Must contain exactly ONE vc_h264,f_mp4 segment
+  const matches = output.match(/vc_h264,f_mp4/g) ?? [];
+  assert.equal(matches.length, 1, `expected 1 vc_h264 segment, got ${matches.length}`);
+});
+
+test("idempotent — already-clean URL stays the same", () => {
+  const input  = `${CLOUD}/vc_h264,f_mp4/${TAIL}`;
+  const output = toStreamingUrl(input);
+  assert.equal(output, input);
+});
+
+test("idempotent — applying twice yields the same result", () => {
+  const raw  = `${CLOUD}/${TAIL}`;
+  const once = toStreamingUrl(raw);
+  const twice = toStreamingUrl(once);
+  assert.equal(once, twice);
+});
+
+test("non-Cloudinary URL passes through unchanged", () => {
+  const input  = "https://example.com/some/video.mp4";
+  assert.equal(toStreamingUrl(input), input);
+});
+
+test("Cloudinary IMAGE URL (not video) passes through unchanged", () => {
+  const input = "https://res.cloudinary.com/dvkbgodbk/image/upload/v1/flexa-market/a.jpg";
+  assert.equal(toStreamingUrl(input), input);
+});
+
+test("empty string passes through unchanged", () => {
+  assert.equal(toStreamingUrl(""), "");
+});
+
+test("the exact broken URL from listing 95 → becomes a working URL", () => {
+  // This is the actual URL that was producing the user-visible black screen.
+  const broken = "https://res.cloudinary.com/dvkbgodbk/video/upload/fl_faststart,vc_h264,f_mp4/fl_faststart,vc_h264,f_mp4/v1781025476/flexa-market/vnubcg5cytce3psi0i0s.mov";
+  const fixed  = toStreamingUrl(broken);
+  assert.equal(
+    fixed,
+    "https://res.cloudinary.com/dvkbgodbk/video/upload/vc_h264,f_mp4/v1781025476/flexa-market/vnubcg5cytce3psi0i0s.mov",
+  );
+});
+
+console.log("\n── toPosterUrl ─────────────────────────────────────────────────");
+
+test("poster URL uses so_auto and produces .jpg", () => {
+  const input  = `${CLOUD}/vc_h264,f_mp4/${TAIL}`;
+  const poster = toPosterUrl(input);
+  assert.ok(poster);
+  assert.ok(poster!.includes("so_auto"));
+  assert.ok(poster!.endsWith(".jpg"));
+  assert.ok(!poster!.includes("fl_faststart"));
+});
+
+test("poster URL returns null for non-Cloudinary URLs", () => {
+  assert.equal(toPosterUrl("https://example.com/video.mp4"), null);
+  assert.equal(toPosterUrl(null), null);
+  assert.equal(toPosterUrl(undefined), null);
+});
+
+console.log("\n────────────────────────────────────────────────────────────────");
+console.log(`Passed: ${passed} · Failed: ${failed}`);
+process.exit(failed === 0 ? 0 : 1);
