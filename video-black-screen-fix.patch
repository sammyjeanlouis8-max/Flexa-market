From a020b786b4e8e156364724202dc8d440d9031186 Mon Sep 17 00:00:00 2001
From: emergent-agent-e1 <github@emergent.sh>
Date: Tue, 9 Jun 2026 17:30:11 +0000
Subject: [PATCH] fix(video): eager H.264+faststart transform to eliminate
 black-screen bug

---
 artifacts/api-server/src/lib/cloudinary.ts | 55 +++++++++++++++++++---
 1 file changed, 49 insertions(+), 6 deletions(-)

diff --git a/artifacts/api-server/src/lib/cloudinary.ts b/artifacts/api-server/src/lib/cloudinary.ts
index abc2d94..daa9381 100644
--- a/artifacts/api-server/src/lib/cloudinary.ts
+++ b/artifacts/api-server/src/lib/cloudinary.ts
@@ -9,7 +9,10 @@ export const CLOUD_NAME =
     ? rawCloudName
     : KNOWN_CLOUD_NAME;
 
-export const IS_CONFIGURED = !!(process.env["CLOUDINARY_API_KEY"]);
+export const IS_CONFIGURED = !!(
+  process.env["CLOUDINARY_API_KEY"] &&
+  process.env["CLOUDINARY_API_SECRET"]
+);
 
 if (IS_CONFIGURED) {
   cloudinary.config({
@@ -70,7 +73,7 @@ export async function uploadImage(
 export async function uploadVideoStream(
   stream: Readable,
   contentType: string,
-): Promise<{ url: string; publicId: string }> {
+): Promise<{ url: string; publicId: string; eagerUrl?: string }> {
   assertConfigured();
   return new Promise((resolve, reject) => {
     let settled = false;
@@ -80,11 +83,30 @@ export async function uploadVideoStream(
       try { (cldStream as any)?.destroy?.(); } catch { }
       reject(err instanceof Error ? err : new Error("Cloudinary video upload failed"));
     };
+    // CRITICAL FIX (black-screen bug):
+    //   Force Cloudinary to derive the H.264 + fl_faststart MP4 BEFORE the
+    //   upload call returns. Without this, the secure_url points at the
+    //   original (often HEVC/.mov from iPhones) which most browsers cannot
+    //   decode → black video / no playback.
+    //
+    //   `eager_async: false` waits for the eager derivation to complete.
+    //   For a 20–60s clip this adds 2–8s to the upload but guarantees the
+    //   first viewer sees a real frame, not a black screen.
     const cldStream = cloudinary.uploader.upload_chunked_stream(
       {
         resource_type: "video",
         folder: "flexa-market",
         chunk_size: 20 * 1024 * 1024,
+        eager: [
+          {
+            format: "mp4",
+            video_codec: "h264",
+            audio_codec: "aac",
+            flags: "faststart",
+            quality: "auto",
+          },
+        ],
+        eager_async: false,
       },
       (err, result) => {
         if (settled) return;
@@ -92,7 +114,16 @@ export async function uploadVideoStream(
           fail(err ?? new Error("Cloudinary upload failed"));
         } else {
           settled = true;
-          resolve({ url: result.secure_url, publicId: result.public_id });
+          // Prefer the fully-baked eager URL (already H.264 + faststart) so
+          // playback works on every browser/device immediately.
+          const eagerUrl: string | undefined = Array.isArray((result as any).eager) && (result as any).eager[0]?.secure_url
+            ? (result as any).eager[0].secure_url
+            : undefined;
+          resolve({
+            url: eagerUrl ?? result.secure_url,
+            publicId: result.public_id,
+            eagerUrl,
+          });
         }
       },
     );
@@ -108,11 +139,23 @@ export async function prewarmVideo(
 ): Promise<string> {
   if (!rawUrl.includes("res.cloudinary.com") || !rawUrl.includes("/video/upload/")) return rawUrl;
   const streamingUrl = toStreamingUrl(rawUrl);
+
+  // If the upload already returned an "eager" URL it is fully derived. A HEAD
+  // is enough to confirm. Otherwise we do a real ranged GET so Cloudinary
+  // actually finishes the on-the-fly derivation (HEAD alone often returns
+  // 423/processing without waiting for the transcode to finish, which is
+  // what caused the persistent "black video on first view" bug).
   try {
-    await fetch(streamingUrl, { method: "HEAD", signal: AbortSignal.timeout(25_000) });
-    log?.info({ streamingUrl }, "Cloudinary video pre-warmed");
+    const res = await fetch(streamingUrl, {
+      method: "GET",
+      headers: { Range: "bytes=0-65535" },
+      signal: AbortSignal.timeout(60_000),
+    });
+    // Drain the body so the connection completes and the derivation is cached.
+    try { await res.arrayBuffer(); } catch { /* ignore */ }
+    log?.info({ streamingUrl, status: res.status }, "Cloudinary video pre-warmed");
   } catch (e) {
-    log?.warn({ streamingUrl, err: e }, "Cloudinary pre-warm timed out — client will use streaming URL anyway");
+    log?.warn({ streamingUrl, err: e }, "Cloudinary pre-warm timed out — client will fall back to eager URL");
   }
   return streamingUrl;
 }
